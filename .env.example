# Copie para .env.local (desenvolvimento) e cadastre as mesmas variáveis na Vercel.

# Sua chave pessoal: qualquer texto longo e aleatório (ex.: gere em https://www.uuidgenerator.net).
# É ela que protege seus dados; os apps e o hub enviam essa chave em toda chamada.
CL4P_TOKEN=

# Upstash Redis (https://console.upstash.com → Create Database → aba REST API).
# Se criar pela integração da Vercel (Storage → Upstash), as variáveis KV_REST_API_URL/KV_REST_API_TOKEN também funcionam.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Gemini (https://aistudio.google.com/apikey) para o chat
GEMINI_API_KEY=
# Opcional
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_FALLBACK_MODELS=
# CL4P_DONO=João Pedro
