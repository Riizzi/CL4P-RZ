{
  "name": "cl4p-rz",
  "private": true,
  "version": "1.0.0",
  "description": "Hub pessoal que cruza os dados dos apps RetroFin, RoutineTracker, SmartPantry, WishWatch, PaperTrail e RotMG Account Manager, com um chatbot que responde sobre você.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite --host --port 3000",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/core/*.test.ts api/_lib/*.test.ts",
    "build": "tsc --noEmit && vite build",
    "sync": "npm run build && cap sync android",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/app": "8.1.1",
    "@capacitor/app-launcher": "8.0.1",
    "@capacitor/browser": "8.0.5",
    "@capacitor/core": "8.5.2",
    "@capacitor/local-notifications": "8.3.1",
    "@capgo/capacitor-health": "8.11.4",
    "@fontsource/plus-jakarta-sans": "5.3.0",
    "@fontsource/space-mono": "5.3.0",
    "@google/genai": "^2.4.0",
    "ical.js": "2.2.1",
    "lucide-react": "1.48.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^22.14.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.1"
  }
}
